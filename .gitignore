# Python
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.ruff_cache/

# Virtualenvs. No trailing slash on .venv: an agent's worktree symlinks it at a
# shared interpreter, and `.venv/` does not match a symlink - which is how one got
# committed, absolute path and all.
.venv
venv/

# uv writes this on `uv run`, but this project resolves deps from
# requirements*.txt - pyproject.toml declares no [project] to lock.
uv.lock

# macOS Finder metadata; packaging residue
.DS_Store
*.egg-info/

# The fixture site is built by CI on Linux and by hand on macOS; a lockfile from either
# pins the other platform out.
tests/fixtures/site/Gemfile.lock
