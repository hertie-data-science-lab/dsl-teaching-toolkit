# Worked example for the hertie-dsl-demo-f2026 cohort's whole term in one file. 
# full schema: https://github.com/hertie-data-science-lab/dsl-teaching-toolkit/blob/main/docs/07-schedule-releases.md

timezone: Europe/Berlin
semester_start: 2026-09-07
semester_end: 2026-12-18

releases:
  course-intro:
    event_datetime: 2026-08-31T09:00   # week 0 - the course opens before teaching starts
    title: Course opens
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: syllabus.md     # a root file
  lecture-1:
    event_datetime: 2026-09-01T10:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: lectures/01_week-1
        deploy_datetime: 2026-09-01T09:00
      - course_source_repo: course-materials-f2026
        course_source_path: readings/01_week-1
      - course_source_repo: lecture-code-f2026
        course_source_path: mlpkg/core
  lab-1:
    event_datetime: 2026-09-03T14:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: labs/01_week-1
  lecture-2:
    event_datetime: 2026-09-08T10:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: lectures/02_week-2
        deploy_datetime: 2026-09-08T09:00
      - course_source_repo: course-materials-f2026
        course_source_path: readings/02_week-2
  lab-2:
    event_datetime: 2026-09-10T14:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: labs/02_week-2
  lecture-3:
    event_datetime: 2026-09-15T10:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: lectures/03_week-3
        deploy_datetime: 2026-09-15T09:00
      - course_source_repo: course-materials-f2026
        course_source_path: readings/03_week-3
      - course_source_repo: lecture-code-f2026
        course_source_path: mlpkg/simulation
  lab-3:
    event_datetime: 2026-09-17T14:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: labs/03_week-3
  lecture-4:
    event_datetime: 2026-09-22T10:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: lectures/04_week-4
        deploy_datetime: 2026-09-22T09:00
      - course_source_repo: course-materials-f2026
        course_source_path: readings/04_week-4
  lab-4:
    event_datetime: 2026-09-24T14:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: labs/04_week-4
  lecture-5:
    event_datetime: 2026-09-29T10:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: lectures/05_week-5
        deploy_datetime: 2026-09-29T09:00
      - course_source_repo: course-materials-f2026
        course_source_path: readings/05_week-5
      - course_source_repo: lecture-code-f2026
        course_source_path: mlpkg/training
  lab-5:
    event_datetime: 2026-10-01T14:00
    deploy:
      - course_source_repo: course-materials-f2026
        course_source_path: labs/05_week-5

assignments:                    
  assignment-1:
    course_source_repo: assignment-1-f2026  # REQUIRED - provision one repo per student/group from it
    handout_datetime: 2026-09-15T14:00  
    due_datetime: 2026-10-13            # what students see
    grading_datetime: 2026-10-15        # optional grading pin - snapshot + autograde (if undefined, default = due_datetime)
  assignment-2:
    course_source_repo: assignment-2-f2026
    cohort_dest_repo: homework-2      # optional: the cohort-side name. Default if undefined: the top-level slug (assignment-2).
    handout_datetime: 2026-09-29T14:00
    due_datetime: 2026-10-27T23:59
  assignment-4-project:
    course_source_repo: assignment-4-project-f2026
    handout_datetime: 2026-10-13T14:00
    type: group                   # per-team handout + grading (also set in the template's grading.yml; if declared here this overwrites it)
    due_datetime: 2026-11-15T23:59
    max_team_size: 4              # the welcome "Join team" flow refuses a 5th member

events:
  mid-term:
    type: exam                 # special types: exam -> dedicated colouring in the deployed schedule
    title: MidTerm Exam
    event_datetime: tbc         # fully provisional - no date shown             
  final-exam:
    type: exam
    title: Final Exam
    event_datetime: 2026-12-15T14:00   
    tbc: true                    # partially provisional - the site shows "(TBC)" next to the date
  project-clinic:                # no `type:` -> a special event row
    title: Project clinic
    event_datetime: 2026-11-10T10:00
  guest-lecture:
    title: Guest lecture (industry speaker)
    event_datetime: tbc
