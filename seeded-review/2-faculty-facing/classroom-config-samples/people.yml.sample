# This cohort's own instructors/TAs 
#
# - the SSOT for their GitHub access & permissions 
# - supplies the deployed .github.io site's staff cards (name/title/photo/url). 
# - see reference: https://github.com/hertie-data-science-lab/dsl-teaching-toolkit/blob/main/docs/05-manage-teaching-team.md
#
# `photo` takes either (1) an absolute URL on a host that allows hotlinking (GitHub
# avatars always do), or (2) a site-relative path to an image committed into this
# cohort's site repo under `_images/pp/`. 

people:
  instructors:
    - github_handle: "demo-lkaack-placeholder"
      name: "Prof. Lynn Kaack, PhD"
      title: "Assistant Professor of Computer Science and Public Policy"
      photo: "https://github.com/LynnKaack.png"
      url: "https://www.hertie-school.org/de/research/faculty-and-researchers/profile/person/kaack"
  teaching_assistants:
