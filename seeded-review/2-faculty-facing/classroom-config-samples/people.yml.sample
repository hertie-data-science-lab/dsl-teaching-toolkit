      name: "Chiara Fusar Bassini"
      title: "PhD candidate, Data Science Lab"
      photo: "https://github.com/chiara-fb.png"
      url: "https://www.hertie-school.org/en/who-we-are/profile/person/fusar-bassini"
      start: "2026-08-01"
      end: "2027-01-31"
    - github_handle: "demo-rmoreau-placeholder"
