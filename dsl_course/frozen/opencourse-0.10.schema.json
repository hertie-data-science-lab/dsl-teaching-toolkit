{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "include_lectures": {
      "type": "boolean"
    },
    "readings_mode": {
      "enum": [
        "reading-list",
        "actual-readings",
        "none"
      ],
      "type": "string"
    },
    "source_repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "withhold": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "title": ".github/opencourse.yml",
  "type": "object"
}
