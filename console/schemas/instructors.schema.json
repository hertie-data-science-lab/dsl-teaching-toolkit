{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "instructors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "github_handle": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "role": {
            "enum": [
              "instructor",
              "teaching_assistant"
            ],
            "type": "string"
          },
          "show_email": {
            "type": "boolean"
          },
          "start": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "github_handle",
          "role",
          "email"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "title": "semester-config/instructors.yml",
  "type": "object"
}
