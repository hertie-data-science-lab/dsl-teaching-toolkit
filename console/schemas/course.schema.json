{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "course": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "student_console": {
          "type": "boolean"
        },
        "toolkit_version_ref": {
          "pattern": "^(?:main|release|preview|[0-9a-f]{40})$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "archive_grace_days": {
          "type": "integer"
        },
        "assignment_repo_visibility": {
          "enum": [
            "private",
            "public",
            "student_choice"
          ],
          "type": "string"
        },
        "late_penalty_per_day": {
          "type": [
            "string",
            "number"
          ]
        },
        "late_window_days": {
          "type": "integer"
        },
        "marks_per_question": {
          "type": "boolean"
        },
        "materials_repo": {
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        "max_team_size": {
          "type": "integer"
        },
        "team_formation": {
          "enum": [
            "self_select",
            "assigned"
          ],
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "open_course_site": {
      "additionalProperties": false,
      "properties": {
        "contact": {
          "pattern": "^[^@\\s]+@[^@\\s]+$",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "include_lectures": {
          "type": "boolean"
        },
        "readings_mode": {
          "enum": [
            "reading-list",
            "actual-readings",
            "none"
          ],
          "type": "string"
        },
        "source_repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "withhold": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "people": {
      "additionalProperties": false,
      "properties": {
        "course_admins": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "github_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "photo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "github_handle"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "set_aside": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": ".github/course.yml",
  "type": "object"
}
