{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_defaults": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "oneOf": [
            {
              "items": {
                "enum": [
                  "ipynb",
                  "py",
                  "rmd",
                  "qmd",
                  "latex",
                  "none"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ]
        },
        "late_penalty_per_day": {
          "type": [
            "string",
            "number"
          ]
        },
        "late_window_days": {
          "type": "integer"
        },
        "marks_per_question": {
          "type": "boolean"
        },
        "max_team_size": {
          "type": "integer"
        },
        "submit_via": {
          "enum": [
            "assignment_repo",
            "shared_dropbox_repo",
            "external"
          ],
          "type": "string"
        },
        "team_formation": {
          "enum": [
            "self_select",
            "assigned"
          ],
          "type": "string"
        },
        "visibility": {
          "enum": [
            "private",
            "public",
            "student_choice"
          ],
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "central_ref": {
      "pattern": "^(?:main|release|preview|[0-9a-f]{40})$",
      "type": "string"
    },
    "contact": {
      "pattern": "^[^@\\s]+@[^@\\s]+$",
      "type": "string"
    },
    "course_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "course_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "course_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "licence": {
      "type": [
        "string",
        "null"
      ]
    },
    "people": {
      "additionalProperties": false,
      "properties": {
        "course_admins": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "github_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "github_handle"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "instructors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "github_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "photo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "teaching_assistants": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "github_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "photo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "set_aside": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "site_link_extensions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "student_console": {
      "type": "boolean"
    }
  },
  "title": ".github/dsl-course.yml",
  "type": "object"
}
