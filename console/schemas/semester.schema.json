{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "archive_grace_days": {
          "type": "integer"
        },
        "assignment_repo_visibility": {
          "enum": [
            "private",
            "public",
            "student_choice"
          ],
          "type": "string"
        },
        "late_penalty_per_day": {
          "type": [
            "string",
            "number"
          ]
        },
        "late_window_days": {
          "type": "integer"
        },
        "marks_per_question": {
          "type": "boolean"
        },
        "materials_repo": {
          "pattern": "^[\\w.-]+$",
          "type": "string"
        },
        "max_team_size": {
          "type": "integer"
        },
        "team_formation": {
          "enum": [
            "self_select",
            "assigned"
          ],
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "people": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "github_handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "photo": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "instructor",
              "teaching_assistant"
            ],
            "type": "string"
          },
          "show_email": {
            "type": "boolean"
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "github_handle",
          "role",
          "email"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "student_site": {
      "additionalProperties": false,
      "properties": {
        "syllabus": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "title": "semester-config/semester.yml",
  "type": "object"
}
